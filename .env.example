# Phase 1 generator configuration
FINBANK_CUSTOMERS=1000
FINBANK_ACCOUNTS=1200
FINBANK_MERCHANTS=200
FINBANK_TRANSACTIONS=10000
FINBANK_SUSPICIOUS_CUSTOMER_PCT=5
FINBANK_SEED=42
FINBANK_OUTPUT_DIR=data/generated
FINBANK_LOG_LEVEL=INFO

# Phase 2 / Phase 3 Kafka configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions
KAFKA_CONSUMER_GROUP=finbank-transaction-consumer

# Phase 3 native PostgreSQL configuration
# Replace change_me with the local development password you created during setup.
POSTGRES_DSN=postgresql://finbank:change_me@localhost:5432/finbank
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_RETRY_ATTEMPTS=3
POSTGRES_RETRY_BACKOFF_SECONDS=1
